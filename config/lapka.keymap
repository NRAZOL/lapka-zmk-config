#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define NUM 3
#define MSE 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_lang {
            timeout-ms = <50>;
            key-positions = <31 33>;
            bindings = <&kp LG(SPACE)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers  = <NAV SYM>;
            then-layer = <NUM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        def_layer {
            bindings = <
&kp Q       &kp W       &kp E        &kp R        &kp T          &kp Y       &kp U        &kp I        &kp O       &kp P
&hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G          &kp H       &hm RSHFT J  &hm RCTRL K  &hm LALT L  &hm RGUI SQT
&kp Z       &kp X       &kp C        &kp V        &kp B          &kp N       &kp M        &kp COMMA    &kp DOT     &kp FSLH
                         &kp ESC      &lt MSE SPACE &lt NAV TAB    &kp RET     &lt SYM BSPC &kp DEL
            >;
        };

        nav_layer {
            bindings = <
&none       &none       &none        &none        &none          &kp K_REDO  &kp K_PASTE  &kp K_COPY   &kp K_CUT   &kp K_UNDO
&kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &none          &kp CAPS    &kp LEFT     &kp DOWN     &kp UP      &kp RIGHT
&none       &none       &none        &none        &none          &kp INS     &kp HOME     &kp PG_DN    &kp PG_UP   &kp END
                         &none        &trans       &none          &kp RET     &kp BSPC     &kp DEL
            >;
        };

        sym_layer {
            bindings = <
&kp EXCL    &kp AT      &kp HASH     &kp DLLR     &kp PRCNT      &kp CARET   &kp AMPS     &kp ASTRK    &kp LPAR    &kp RPAR
&kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &none          &none       &kp MINUS    &kp EQUAL    &kp LBKT    &kp RBKT
&none       &none       &none        &none        &none          &none       &kp GRAVE    &kp BSLH     &kp SEMI    &none
                         &none        &none        &none          &trans      &trans       &none
            >;
        };

        num_layer {
            bindings = <
&kp N1      &kp N2      &kp N3       &kp N4       &kp N5         &kp N6      &kp N7       &kp N8       &kp N9      &kp N0
&kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &none          &kp F12     &kp F7       &kp F8       &kp F9      &kp PSCRN
&none       &none       &none        &none        &none          &kp F11     &kp F4       &kp F5       &kp F6      &kp SLCK
                         &none        &none        &none          &kp F10     &kp F1       &kp F2
            >;
        };

        mse_layer {
            bindings = <
&none       &none       &none        &none        &none          &none       &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
&kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &none          &none       &mkp LCLK    &mkp MCLK    &mkp RCLK   &none
&none       &none       &none        &none        &none          &none       &none        &none        &none       &none
                         &none        &trans       &none          &mkp LCLK   &mkp RCLK    &mkp MCLK
            >;
        };
    };
};
